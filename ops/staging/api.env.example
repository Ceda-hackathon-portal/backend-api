DATABASE_URL=postgresql://ceda_app:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/ceda_staging
DATABASE_SSL=true
DATABASE_CA_FILE=/run/db/ca.crt
DATABASE_POOL_MAX=5
ALLOWED_ORIGINS=https://portal.staging.example.org,https://api.staging.example.org
AUTH_ENABLED=false
OFFICER_READ_API_ENABLED=false
AUTH_API_ORIGIN=https://api.staging.example.org
AUTH_FRONTEND_ORIGIN=https://portal.staging.example.org
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
LOG_LEVEL=info
# Enable only after approved pool/callback setup and real browser verification.
# COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/APPROVED_POOL_ID
# COGNITO_CLIENT_ID=APPROVED_CLIENT_ID
# COGNITO_CLIENT_SECRET=SERVER_ONLY_IF_REQUIRED
# AUTH_ENCRYPTION_KEY=SERVER_ONLY_64_HEX_CHARACTERS
