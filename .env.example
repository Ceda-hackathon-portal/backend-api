# Copy to .env for local development. In AWS these values come from
# Secrets Manager / SSM Parameter Store via the ECS task definition, never from this file.

# Port the HTTP server listens on (the container and load balancer expect 8080)
PORT=8080

# Runtime environment: development | production
APP_ENV=development

# Database connection (RDS in AWS)
DATABASE_URL=postgresql://ceda:ceda@localhost:5432/ceda_portal

# Comma-separated origins allowed by CORS (front-end URLs)
CORS_ORIGINS=http://localhost:5173

# Secret used to sign session tokens. Generate a long random value; never commit a real one.
AUTH_SECRET=change-me

# S3 bucket for submission attachments
UPLOADS_BUCKET=
AWS_REGION=af-south-1
