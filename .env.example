NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://ceda:replace-me@127.0.0.1:5432/ceda_dev
DATABASE_SSL=false
ALLOWED_ORIGINS=http://localhost:5173
AUTH_ENABLED=false
AUTH_API_ORIGIN=http://localhost:3001
AUTH_FRONTEND_ORIGIN=http://localhost:5173
# To enable approved hosted login, supply COGNITO_ISSUER, COGNITO_CLIENT_ID
# and a server-only 64-hex AUTH_ENCRYPTION_KEY. Client secret is optional.
# Production requires HTTPS and DATABASE_SSL=true; DATABASE_CA_FILE is optional.
# Local password sign-in (development and loopback only). Keep AUTH_ENABLED=false and uncomment AUTH_MODE:
# the server refuses to start when both local mode and AUTH_ENABLED=true are set.
# AUTH_MODE=local
# AUTH_LOCAL_EMAIL=dev-applicant@example.test
# AUTH_LOCAL_NAME=Development Applicant
# AUTH_LOCAL_PASSWORD_HASH= (generate with: npm run auth:hash-local-password)
# AUTH_ENCRYPTION_KEY= (64 random hex characters)
# AUTH_LOCAL_ACCOUNTS_FILE= (extra development sign-ins, written by scripts/provision-local.mjs)
# Staff assignment needs its own login in ops/assignment-provisioner-role.sql's role. Without it those commands return 503.
# ASSIGNMENT_DATABASE_URL=
# Read-only officer HTTP remains opt-in; requires approved assignment/conflict provisioning.
OFFICER_READ_API_ENABLED=false
# Private local file store (keep outside any static/public directory).
APPLICATION_STORAGE_DIR=.runtime/application-files
